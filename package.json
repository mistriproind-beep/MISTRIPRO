{
  "name": "mistripro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MISTRI PRO - Two-sided construction and home-services marketplace ecosystem",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:backend": "pnpm --filter @mistripro/backend dev",
    "dev:admin": "pnpm --filter @mistripro/admin-web dev",
    "lint": "pnpm -r run lint"
  },
  "keywords": [
    "mistripro",
    "marketplace",
    "construction",
    "handyman"
  ],
  "author": "MISTRI PRO Team",
  "license": "UNLICENSED",
  "prisma": {
    "schema": "apps/backend/prisma/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "prisma"
    ]
  }
}
