datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  WORKER
  ADMIN
}

enum WorkerVerificationStatus {
  UNVERIFIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  OTHER
}

enum PaymentBasis {
  DAILY
  FIXED_PROJECT
  NEGOTIABLE
}

enum ProjectStatus {
  DRAFT
  PENDING_PAYMENT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequirementStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum AssignmentStatus {
  SELECTED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_COMPLETED
  AGREEMENT_CONFIRMED
  WORK_STARTED
  WORK_IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  DISPUTED
  CANCELLED
}

enum SiteVisitStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum SupportedLanguage {
  EN
  HI
  GU
  MR
}

model User {
  id                String            @id @default(uuid())
  phone             String?           @unique
  email             String?           @unique
  username          String?           @unique // dev test: 'abc'
  passwordHash      String?
  role              Role              @default(CUSTOMER)
  preferredLanguage SupportedLanguage @default(EN)
  isDevTestAccount  Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?
  addresses       Address[]
  notifications   Notification[]
  sentMessages    Message[]        @relation("SentMessages")
  auditLogs       AuditLog[]
}

model CustomerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  profilePhoto   String?
  alternatePhone String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[]
}

model WorkerProfile {
  id                       String                   @id @default(uuid())
  userId                   String                   @unique
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                 String
  profilePhoto             String?
  alternatePhone           String?
  addressLine              String
  city                     String
  state                    String
  pincode                  String
  latitude                 Float?
  longitude                Float?
  preferredWorkingRadiusKm Int                      @default(25)
  isTeamLeader             Boolean                  @default(false)
  maxTeamSize              Int                      @default(1)
  dailyWageExpectation     Float?
  yearsOfExperience        Int                      @default(0)
  workDescription          String?
  verificationStatus       WorkerVerificationStatus @default(UNVERIFIED)
  rejectionReason          String?
  verifiedAt               DateTime?
  ratingAverage            Float                    @default(0.0)
  totalReviewsCount        Int                      @default(0)
  completedJobsCount       Int                      @default(0)
  isAvailable              Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  skills       WorkerSkill[]
  documents    WorkerDocument[]
  applications ProjectApplication[]
  assignments  WorkerAssignment[]
}

model SkillCategory {
  id          String   @id @default(uuid())
  code        String   @unique // MASON, CARPENTER, etc.
  nameEn      String
  nameHi      String
  nameGu      String
  nameMr      String
  description String?
  icon        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workerSkills        WorkerSkill[]
  projectRequirements ProjectRequirement[]
}

model WorkerSkill {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skillCategoryId String
  skillCategory   SkillCategory @relation(fields: [skillCategoryId], references: [id])
  isPrimary       Boolean       @default(false)
  experienceYears Int           @default(0)

  @@unique([workerProfileId, skillCategoryId])
}

model WorkerDocument {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  documentType    String // AADHAAR, PAN, VOTER_ID, DRIVING_LICENSE
  documentNumber  String // Masked for privacy
  documentPhotoUrl String // Stored securely
  isVerified      Boolean       @default(false)
  createdAt       DateTime      @default(now())
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("Home")
  addressLine String
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Project {
  id                         String        @id @default(uuid())
  projectCode                String        @unique // MISTRI-26110001
  customerId                 String
  customer                   CustomerProfile @relation(fields: [customerId], references: [id])
  title                      String
  description                String
  projectType                ProjectType   @default(RESIDENTIAL)
  status                     ProjectStatus @default(DRAFT)
  addressLine                String
  landmark                   String?
  city                       String
  state                      String
  pincode                    String
  latitude                   Float
  longitude                  Float
  totalEstimatedBudget       Float
  paymentBasis               PaymentBasis  @default(NEGOTIABLE)
  expectedWagePerWorker      Float?
  estimatedStartDate         DateTime
  expectedDuration           String?
  foodAccommodationProvided Boolean       @default(false)
  materialsProvided          Boolean       @default(false)
  additionalInstructions     String?
  contactPersonName          String
  primaryPhone               String
  alternatePhone             String?
  listingFeePaid             Boolean       @default(false)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  photos        ProjectPhoto[]
  requirements  ProjectRequirement[]
  payments      Payment[]
  conversations Conversation[]
}

model ProjectPhoto {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photoUrl  String
  createdAt DateTime @default(now())
}

model ProjectRequirement {
  id                  String             @id @default(uuid())
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillCategoryId     String
  skillCategory       SkillCategory      @relation(fields: [skillCategoryId], references: [id])
  requiredCount       Int                @default(1)
  selectedCount       Int                @default(0)
  status              RequirementStatus  @default(OPEN)
  specialInstructions String?
  createdAt           DateTime           @default(now())

  applications ProjectApplication[]
  assignments  WorkerAssignment[]
}

model ProjectApplication {
  id                   String             @id @default(uuid())
  projectRequirementId String
  projectRequirement  ProjectRequirement @relation(fields: [projectRequirementId], references: [id], onDelete: Cascade)
  workerId             String
  worker               WorkerProfile      @relation(fields: [workerId], references: [id])
  proposedWage         Float?
  coverMessage         String?
  status               ApplicationStatus  @default(SUBMITTED)
  appliedAt            DateTime           @default(now())

  assignment WorkerAssignment?

  @@unique([projectRequirementId, workerId])
}

model WorkerAssignment {
  id                   String             @id @default(uuid())
  projectRequirementId String
  projectRequirement  ProjectRequirement @relation(fields: [projectRequirementId], references: [id])
  applicationId        String             @unique
  application          ProjectApplication @relation(fields: [applicationId], references: [id])
  workerId             String
  worker               WorkerProfile      @relation(fields: [workerId], references: [id])
  status               AssignmentStatus   @default(SELECTED)
  agreedWage           Float?
  startDate            DateTime?
  completionDate       DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  siteVisits  SiteVisit[]
  workUpdates WorkUpdate[]
  review      Review?
}

model SiteVisit {
  id           String          @id @default(uuid())
  assignmentId String
  assignment   WorkerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  visitDate    DateTime
  visitTime    String
  purpose      String
  status       SiteVisitStatus @default(REQUESTED)
  notes        String?
  createdAt    DateTime        @default(now())
}

model WorkUpdate {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   WorkerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status       AssignmentStatus
  notes        String
  photoUrls    String[]
  createdAt    DateTime         @default(now())
}

model Payment {
  id                    String        @id @default(uuid())
  projectId             String
  project               Project       @relation(fields: [projectId], references: [id])
  razorpayOrderId       String        @unique
  razorpayPaymentId     String?       @unique
  razorpaySignature     String?
  amountInPaise         Int           @default(29900) // 299.00 INR
  currency              String        @default("INR")
  status                PaymentStatus @default(CREATED)
  paymentPurpose        String        @default("REQUEST_LISTING_FEE")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  refunds Refund[]
}

model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id])
  razorpayRefundId String?
  amountInPaise    Int
  reason           String
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
}

model Review {
  id                 String           @id @default(uuid())
  assignmentId       String           @unique
  assignment         WorkerAssignment @relation(fields: [assignmentId], references: [id])
  rating             Int              // 1 to 5
  reviewText         String
  punctualityScore   Int?             // 1 to 5
  workQualityScore   Int?             // 1 to 5
  behaviourScore     Int?             // 1 to 5
  photoUrls          String[]
  isVerifiedPurchase Boolean          @default(true)
  isApprovedByAdmin  Boolean          @default(true)
  createdAt          DateTime         @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  imageUrl       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  adminUser  User?    @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
