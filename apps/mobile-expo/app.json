{
  "expo": {
    "name": "MISTRI PRO",
    "slug": "mistripro",
    "scheme": "mistripro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mistripro.app",
      "config": {
        "googleMapsApiKey": "AIzaSyD9Waw124X0qILg7C_OnIZ7ManSwl_wT50"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mistri Pro needs your GPS location to connect you with verified skilled mistris and contractors near you.",
        "NSCameraUsageDescription": "Mistri Pro needs camera access to capture Aadhaar verification documents and profile photos.",
        "NSPhotoLibraryUsageDescription": "Mistri Pro needs photo library access to upload identity verification documents."
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD9Waw124X0qILg7C_OnIZ7ManSwl_wT50"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mistripro.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mistripro"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "VIBRATE",
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "5320c82e-3b9d-46a5-b6df-cd443ec17d96"
      },
      "googleMapsApiKey": "AIzaSyD9Waw124X0qILg7C_OnIZ7ManSwl_wT50"
    },
    "owner": "yashendrajain030205"
  }
}
